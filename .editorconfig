# So files do not change shape depending on which editor opens them.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{qml,js,json,jsonc}]
indent_size = 4

[*.lua]
indent_size = 2

[{*.yml,*.yaml,*.toml}]
indent_size = 2

[*.md]
# In markdown, two trailing spaces are a deliberate line break.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Third-party config files are left exactly as they come.
[home/.config/{spicetify,yazi/flavors}/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
