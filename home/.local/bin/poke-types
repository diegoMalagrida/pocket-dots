#!/usr/bin/env python3
"""poke-types — stores locally each pokemon's type and each type's colour.

The notch's team uses it to paint each critter's type pill. It runs ONCE and
from then on everything comes out of ~/.cache/pokepalette/tipos.json.

    poke-types              downloads whatever is missing
    poke-types --force      rebuilds it from scratch

IT IS 18 REQUESTS, NOT 1025. The trick is to ask by TYPE and not by pokemon:
/type/fire returns ALL the fire ones in one go. Asking for the 18 types covers
the entire pokedex -- per pokemon it would be 1025 requests and several
minutes.

The colours are NOT downloaded: they are the series' usual ones and are written
here. Careful, they are used as they are over the notch's background, so the
ones that are almost white on the official website (ice, fairy) are a shade
darker so that the black text on top stays readable.

Format: {"colores": {"fire": "#EE8130", ...},
         "es": {"fire": "Fuego", ...},
         "pokemon": {"4": ["fire"], "6": ["fire","flying"], ...}}
"""

from __future__ import annotations

import argparse
import json
import sys
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path


def tr(es, en):
    try:
        import json
        from pathlib import Path
        with (Path.home() / ".config/quickshell-rice.json").open(encoding="utf-8") as f:
            return en if json.load(f).get("language") == "en" else es
    except (OSError, ValueError, AttributeError):
        return es


CACHE = Path.home() / ".cache" / "pokepalette"
DESTINO = CACHE / "tipos.json"
API = "https://pokeapi.co/api/v2"

TIPOS = ["normal", "fighting", "flying", "poison", "ground", "rock", "bug",
         "ghost", "steel", "fire", "water", "grass", "electric", "psychic",
         "ice", "dragon", "dark", "fairy"]

COLORES = {
    "normal": "#A8A77A", "fighting": "#C22E28", "flying": "#A98FF3",
    "poison": "#A33EA1", "ground": "#E2BF65", "rock": "#B6A136",
    "bug": "#A6B91A", "ghost": "#735797", "steel": "#B7B7CE",
    "fire": "#EE8130", "water": "#6390F0", "grass": "#7AC74C",
    "electric": "#F7D02C", "psychic": "#F95587", "ice": "#8AC5D6",
    "dragon": "#6F35FC", "dark": "#705746", "fairy": "#E08FAC",
}

ES = {
    "normal": "Normal", "fighting": "Lucha", "flying": "Volador",
    "poison": "Veneno", "ground": "Tierra", "rock": "Roca", "bug": "Bicho",
    "ghost": "Fantasma", "steel": "Acero", "fire": "Fuego", "water": "Agua",
    "grass": "Planta", "electric": "Eléctrico", "psychic": "Psíquico",
    "ice": "Hielo", "dragon": "Dragón", "dark": "Siniestro", "fairy": "Hada",
}


def pedir(url: str) -> dict:
    pet = urllib.request.Request(url, headers={"User-Agent": "poke-types/1.0"})
    with urllib.request.urlopen(pet, timeout=30) as r:
        return json.load(r)


def main() -> int:
    p = argparse.ArgumentParser(description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--force", action="store_true")
    p.add_argument("-q", "--quiet", action="store_true")
    args = p.parse_args()

    if DESTINO.exists() and not args.force:
        ya = json.loads(DESTINO.read_text())
        print(tr(f"ya estaba: {len(ya.get('pokemon', {}))} pokemon con tipo en {DESTINO}",
                 f"Already present: {len(ya.get('pokemon', {}))} Pokémon with types in {DESTINO}"))
        return 0

    # ORDER MATTERS and cannot be left to chance: asking for the 18 types in
    # parallel, each pokemon got its types in the order the network answered,
    # and Charizard came out "volador/fuego" (flying/fire) when it is fire
    # first. That is why the 'slot' the API gives (1 = primary, 2 = secondary)
    # is stored and everything is sorted by it at the end.
    de_pokemon: dict[int, list] = {}
    fallos = 0

    def uno(t: str):
        try:
            return t, pedir(f"{API}/type/{t}")
        except Exception:
            return t, None

    with ThreadPoolExecutor(max_workers=6) as pool:
        for t, datos in pool.map(uno, TIPOS):
            if datos is None:
                fallos += 1
                if not args.quiet:
                    print(tr(f"  fallo con {t}", f"  Failed for {t}"), file=sys.stderr)
                continue
            for fila in datos.get("pokemon", []):
                url = (fila.get("pokemon") or {}).get("url", "")
                try:
                    num = int(url.rstrip("/").rsplit("/", 1)[-1])
                except ValueError:
                    continue
                if num > 1025:
                    continue          # alternative forms: nobody here uses them
                de_pokemon.setdefault(num, []).append((fila.get("slot", 9), t))

    CACHE.mkdir(parents=True, exist_ok=True)
    ordenados = {str(k): [t for _, t in sorted(v)]
                 for k, v in sorted(de_pokemon.items())}
    fuera = {"colores": COLORES, "es": ES, "pokemon": ordenados}
    tmp = DESTINO.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(fuera, ensure_ascii=False, indent=0))
    tmp.replace(DESTINO)

    dobles = sum(1 for v in de_pokemon.values() if len(v) > 1)
    print(tr(f"{len(de_pokemon)} pokemon con tipo ({dobles} de tipo doble), "
             f"{fallos} tipos ilegibles -> {DESTINO}",
             f"{len(de_pokemon)} Pokémon with types ({dobles} dual types), {fallos} unreadable types -> {DESTINO}"))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(1)
