#!/usr/bin/env python3
"""Answers xdg-desktop-portal-luminous's screen picker automatically.

Why it exists: luminous asks which monitor to share every time an app asks for
a capture. RustDesk does NOT implement persist_mode/restore_token, so there is
no way for it to "remember" the authorisation: it would always ask. When away
from home there is nobody to answer, and the connection dies.

With LUMIOUS_HEADLESS=1, luminous draws no dialogue at all: it connects to this
socket and waits for the answer. This process acts as the server and always
answers monitor 0.

Protocol (from the project's own stream_message/src/lib.rs):
  socket   $XDG_RUNTIME_DIR/luminus_selector.sock
  frame    native u32 with the length + JSON payload
  request  {"type":"screen_share","monitors":[...]}
  response {"type":"success","index":0} | {"type":"cancel"} | {"type":"busy"}

CAREFUL (security): with this, any application that asks to capture the screen
gets it without asking. It is the unavoidable price of unattended access.
"""
import json
import os
import socket
import struct
import sys
import threading

SOCK = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "luminus_selector.sock"
)


def log(msg):
    print(msg, flush=True)


def read_msg(conn):
    head = b""
    while len(head) < 4:
        chunk = conn.recv(4 - len(head))
        if not chunk:
            return None
        head += chunk
    (length,) = struct.unpack("=I", head)          # native u32
    if length == 0 or length > 1 << 20:
        log(f"Invalid length ({length}); discarding")
        return None
    body = b""
    while len(body) < length:
        chunk = conn.recv(length - len(body))
        if not chunk:
            return None
        body += chunk
    return body


def write_msg(conn, obj):
    payload = json.dumps(obj).encode()
    conn.sendall(struct.pack("=I", len(payload)) + payload)


def handle(conn):
    with conn:
        raw = read_msg(conn)
        if raw is None:
            return
        log(f"Request: {raw.decode('utf-8', 'replace')}")
        try:
            req = json.loads(raw)
        except json.JSONDecodeError:
            log("  Invalid JSON; replying cancel")
            write_msg(conn, {"type": "cancel"})
            return

        monitors = req.get("monitors") or []
        log(f"  Offered monitors: {monitors} -> choosing index 0")
        write_msg(conn, {"type": "success", "index": 0})


def main():
    if os.path.exists(SOCK):
        os.unlink(SOCK)
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCK)
    os.chmod(SOCK, 0o600)          # owner only
    srv.listen(8)
    log(f"Listening on {SOCK}")

    try:
        while True:
            conn, _ = srv.accept()
            threading.Thread(target=handle, args=(conn,), daemon=True).start()
    except KeyboardInterrupt:
        pass
    finally:
        srv.close()
        if os.path.exists(SOCK):
            os.unlink(SOCK)


if __name__ == "__main__":
    sys.exit(main())
