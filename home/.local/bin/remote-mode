#!/usr/bin/env bash
# remote-mode — prepara el portátil para acceso remoto con RustDesk.
#
# El problema que resuelve: hypridle apaga la pantalla a los 7 min y suspende
# el equipo a los 20. Con la pantalla apagada la captura se va a negro, y a un
# equipo suspendido no te puedes conectar de ninguna manera. Este script cambia
# la config de hypridle para que ninguna de las dos cosas pase, sin renunciar
# al bloqueo de sesión.
#
#   remote-mode on      antes de irte de casa
#   remote-mode off     al volver
#   remote-mode status  para ver cómo está

set -uo pipefail

HYPR_DIR="$HOME/.config/hypr"
CONF="$HYPR_DIR/hypridle.conf"
NORMAL="$HYPR_DIR/hypridle.d/normal.conf"
REMOTE="$HYPR_DIR/hypridle.d/remote.conf"

# No hay fichero de marca a proposito: el estado se deduce de QUE config esta
# puesta en hypridle.conf. Una marca aparte se desincroniza en cuanto un paso
# falla a medias (paso: apply copiaba la config, el restart fallaba, y el
# touch de la marca nunca se ejecutaba -> config remota puesta pero estado
# diciendo "apagado").
die() { echo "error: $*" >&2; exit 1; }

is_on() { cmp -s "$CONF" "$REMOTE"; }

notify() { command -v notify-send >/dev/null 2>&1 && notify-send "$@" 2>/dev/null || true; }

on_battery() {
    local s
    for s in /sys/class/power_supply/A{C,DP}*/online; do
        [ -r "$s" ] && [ "$(cat "$s")" = "0" ] && return 0
    done
    return 1
}

apply() {  # $1 = fichero de config a poner en marcha
    cp -f "$1" "$CONF" || die "no se pudo escribir $CONF"
    # reset-failed limpia el contador de arranques de systemd. Sin esto, pulsar
    # el boton varias veces seguidas agota el limite (5 arranques en 10 s),
    # systemd marca la unidad como failed y hypridle se queda MUERTO: ni bloqueo
    # de sesion ni gestion de inactividad. Paso de verdad el 2026-08-04.
    systemctl --user reset-failed hypridle.service 2>/dev/null
    systemctl --user restart hypridle.service 2>/dev/null
    sleep 1
    if ! systemctl --user is-active --quiet hypridle.service; then
        # Segundo intento tras limpiar de nuevo, por si se acumularon reinicios.
        systemctl --user reset-failed hypridle.service 2>/dev/null
        sleep 2
        systemctl --user restart hypridle.service 2>/dev/null
        sleep 1
    fi
    systemctl --user is-active --quiet hypridle.service \
        || die "hypridle NO arranco (config aplicada, pero sin gestion de inactividad): systemctl --user status hypridle"
}

case "${1:-status}" in
on)
    [ -f "$REMOTE" ] || die "falta $REMOTE"
    apply "$REMOTE"
    # Sintaxis Lua (Hyprland 0.55+): `dpms on` a secas es error de sintaxis y
    # hyprctl sale con 7 sin encender nada. Aqui importa mas que en otros
    # sitios: si entras en modo remoto con la pantalla apagada, DPMS off deja
    # de componer y la captura de RustDesk se va a negro.
    hyprctl dispatch 'hl.dsp.dpms("on")' >/dev/null 2>&1

    # RustDesk tiene que estar corriendo para que haya algo a lo que conectarse.
    if ! pgrep -x rustdesk >/dev/null 2>&1; then
        echo "RustDesk no estaba corriendo, lo arranco..."
        setsid rustdesk --tray >/dev/null 2>&1 &
        sleep 5
    fi

    echo "MODO REMOTO ACTIVADO"
    echo "  · no se suspende, no se apaga la pantalla"
    echo "  · sigue bloqueando a los 6 min (se desbloquea en remoto)"
    echo "  · RustDesk: $(pgrep -x rustdesk >/dev/null && echo corriendo || echo 'NO CORRE - revisar')"
    echo "  · ID: $(timeout 15 rustdesk --get-id 2>/dev/null | tail -1)"
    if on_battery; then
        echo
        echo "  AVISO: estás con BATERÍA. Sin suspensión se va a gastar y"
        echo "  cuando se agote perderás el acceso. Déjalo enchufado."
    fi
    notify "Modo remoto ACTIVADO" "Sin suspensión. RustDesk accesible desde fuera."
    ;;
off)
    [ -f "$NORMAL" ] || die "falta $NORMAL"
    apply "$NORMAL"
    echo "Modo remoto desactivado: hypridle vuelve a lo de siempre"
    echo "  (bloqueo 6 min · pantalla 7 min · suspensión 20 min)"
    notify "Modo remoto desactivado" "Ahorro de energía normal restaurado."
    ;;
is-on)
    # Para el boton de Quickshell: imprime on|off y sale 0 siempre.
    is_on && echo on || echo off
    ;;
status)
    is_on && echo "modo remoto: ACTIVADO" || echo "modo remoto: apagado"
    echo "hypridle:  $(systemctl --user is-active hypridle.service 2>&1)"
    echo "rustdesk:  $(pgrep -x rustdesk >/dev/null && echo corriendo || echo parado)"
    echo "corriente: $(on_battery && echo BATERIA || echo enchufado)"
    echo "config en uso:"
    if cmp -s "$CONF" "$REMOTE"; then echo "  remote.conf (sin suspensión)"
    elif cmp -s "$CONF" "$NORMAL"; then echo "  normal.conf (suspende a los 20 min)"
    else echo "  ninguna de las dos: $CONF ha sido modificada a mano"; fi
    ;;
*)
    echo "uso: remote-mode {on|off|status|is-on}" >&2; exit 2 ;;
esac
