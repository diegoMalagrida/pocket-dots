#!/usr/bin/env bash
# Launches asciiquarium with the wallpaper's palette and leaves the terminal as
# it was.
#
# The palette is generated by ~/.config/hypr/scripts/asciiquarium-pywal.sh,
# which also pushes it live into aquariums that are already open when the
# wallpaper changes.
#
# Only two things happen here: write the OSC 4 sequence BEFORE starting -- so
# the aquarium is born with the wallpaper's colours already, without waiting for
# the next wallpaper change -- and give the terminal its palette back on exit.
#
# THAT RESET IS NOT OPTIONAL. OSC 4 redefines the colours of the whole WINDOW,
# not the program's: without it, when you close the aquarium you are left with
# a dyed terminal, and the prompt, ls, everything, painting in clownfish colours
# until you close it. OSC 104 with no arguments returns all 16 to kitty.conf's.
set -u

REAL="/usr/bin/asciiquarium"
PAL="$HOME/.cache/wal/asciiquarium.osc"
HELPER="$HOME/.config/hypr/scripts/asciiquarium-pywal.sh"

# Into a pipe or a file no palette makes sense: get out of the way.
[ -t 1 ] || exec "$REAL" "$@"

# First run or cache deleted: generate it now.
[ -s "$PAL" ] || { [ -x "$HELPER" ] && "$HELPER" >/dev/null 2>&1; }
[ -s "$PAL" ] || exec "$REAL" "$@"   # no palette, the usual aquarium

# The trap is armed BEFORE dyeing anything: if something fails in between, the
# terminal is not left with the colours on.
trap 'printf "\033]104\a"' EXIT HUP INT TERM

cat "$PAL"
"$REAL" "$@"
