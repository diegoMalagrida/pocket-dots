#!/usr/bin/env python3
"""poke-shimeji-pixel — builds a shimeji out of YOUR pixel art sprites.

The shimeji from shimejis.xyz are hand-drawn and clash with the rest of the
desktop, which is all gen5 sprites. This takes the same animated sprite that
pokefetch shows in the terminal (~/.cache/pokeanim/N.gif) and assembles it as a
pet.

    poke-shimeji-pixel pikachu        builds it, converts it and imports it
    poke-shimeji-pixel 25 --escala 3  by number, forcing the upscale

The BEHAVIOUR (walking, climbing, sitting, falling, being dragged by you) is not
invented: it is reused from a shimeji that already works, kept in
~/.local/share/shimejis/plantilla. Only its images are changed.

The gen5 gifs do not carry "just the standing-still animation", as was believed
here at first. Measuring the 1025 in ~/.cache/pokeanim: the median is 72
hand-drawn frames, and they go up to 315 (#894 Regieleki). The flying ones OPEN
AND CLOSE THEIR WINGS in there. Out of all that, ONE frame per pose was used and
the rest thrown away, which is why the critter looked dead: standing, it was a
still photo for ten seconds.

The exception is EIGHT sprites that do not animate anything -- they are a png
stuffed into a gif: the gen 9 paradoxes, Ogerpon and Pecharunt. For those there
is no cycle to walk through, and a warning goes to the error output.

Three different things are built now:

  - the 46 POSTURES the format asks for, by deforming a frame (squash &
    stretch), which is what worked and is kept: sitting, hanging from the
    mouse, falling;
  - the real animation BANKS -- breathing, moving and sitting-, which walk
    through the gif's frames at the pace they were drawn at;
  - and, for the ones that fly, a FLIGHT block that lifts them off the ground.

On top of that each critter moves the way it should: fish jump, snakes
undulate, the rest walk, and the stride comes from how big it is on screen.
"""
from __future__ import annotations
import argparse, atexit, json, re, shutil, subprocess, sys, tempfile, zipfile
from pathlib import Path


def tr(es, en):
    try:
        import json
        from pathlib import Path
        with (Path.home() / ".config/quickshell-rice.json").open(encoding="utf-8") as f:
            return en if json.load(f).get("language") == "en" else es
    except (OSError, ValueError, AttributeError):
        return es


HOME = Path.home()
DIR_GIF = HOME / ".cache" / "pokeanim"
NOMBRES = HOME / ".cache" / "pokepalette" / "nombres.tsv"
BASE = HOME / ".local" / "share" / "shimejis"
PLANTILLA = BASE / "plantilla"
CONV = BASE / "convertidos"
# Which prototypes THIS script has built, and from which pokemon. It is needed
# because the names clash: 'Shimeji.Charmander' may be the hand-drawn one
# downloaded from shimejis.xyz or our pixel art one, and from outside they are
# identical.
REGISTRO = Path.home() / ".cache" / "pokepalette" / "shimejis-pixel.json"
ALTO_OBJETIVO = 110   # FALLBACK: only used if the critter has no entry in the dex

# ── THE SIZE COMES FROM THE CRITTER, NOT FROM THE DRAWING ────────────────────
# This used to be one fixed height for all (110 px) and the scale was rounded to
# an integer. The two together did the opposite of what they intended: since
# integer rounding is a cliff one single pixel wide -- a sprite 73 px tall comes
# out at 146 and one of 74 stays at 74 -- and big critters come drawn with more
# pixels, they were precisely the ones that fell on the wrong side.
# Measured over the 18 installed: the correlation between on-screen height and
# real pokedex height was -0.078 (NEGATIVE), when the raw sprite's is +0.617.
# So the information was in the drawing and the rounding destroyed it: Snorlax
# was the SMALLEST critter on the desktop, Charizard came out smaller than
# Charmander, and 46% of evolutions shrank the critter.
#
# Now the target comes from the pokedex entry, which is already on disk for all
# 1025, and the scale goes in HALVES. With the new one: r = +0.883 and the
# evolutions that shrink drop to 9%.
DEX = HOME / ".cache" / "pokepalette" / "dex"
ALTO_BASE = 100                  # how tall a "Pikachu"-sized critter comes out
ALTO_MIN, ALTO_MAX = 64, 170     # floor and ceiling, in screen pixels
TALLA_REF = 0.85                 # talla(0.4 m, 6 kg) = Pikachu = 1.0


def talla(m: float, kg: float) -> float:
    """A single 'length-like' number for the critter, from height AND weight.

    With height alone, Rayquaza (7 m and slim) and Wailord (14.5 m) would cover
    the screen, and Cosmoem (0.1 m and 999 kg) would be a speck. The sixth root
    of weight is the cube root of a volume, that is, another length: mixing the
    two, a long light critter does not gain as much and a short stocky one does
    not lose as much.
    """
    return (max(m, 0.05) ** 0.5) * (max(kg, 0.05) ** (1 / 6))


def alto_objetivo(num: int) -> int:
    """How many pixels tall we want to SEE this pokemon.

    The curve is a 0.35 power, very flattened on purpose: from Joltik (0.1 m) to
    Wailord (14.5 m) there is a real factor of 145, and here it ends up at 2.7,
    which is what fits on a desktop without one critter covering another.
    """
    try:
        d = json.loads((DEX / f"{num}.json").read_text())
        t = talla(float(d["m"]), float(d["kg"])) / TALLA_REF
    except (OSError, ValueError, KeyError, TypeError):
        return ALTO_OBJETIVO
    return int(round(min(ALTO_MAX, max(ALTO_MIN, ALTO_BASE * t ** 0.35))))
POSES = 46            # the ones the template references

# THE ENGINE'S PACE. wl_shimeji advances one tick every 40 ms (usleep(40000) in
# shimeji-overlay.c:391), that is 25 per second. Every Duration in the XML is
# counted in ticks, so for the animation to run at the pace it was drawn at,
# the gif's delays -which come in milliseconds- have to be converted to this
# unit. Each one is not rounded on its own: the error is carried over, or a gif
# at 100 ms per frame (2.5 ticks) would end up 20% too long or too short over
# the whole cycle.
TICK_MS = 40
MAX_IDLE = 64         # cap on frames in the breathing cycle
PASOS = 12            # frames in the walking cycle
# The LEAST a standing-still cycle may last, in ticks (2.5 s). It is a floor,
# not a target: of the 18 installed only Zapdos hits it, which did its own in
# 0.88 s (see ritmo_minimo). The next fastest, Umbreon, is already at 3.48 and
# is left alone.
REPOSO_MIN = 62

# WHAT EACH POSE IS, taken from reading the template's actions.xml and seeing
# which image each action uses. Without this the 46 poses were gif frames
# handed out in a cycle -- the critter glided along with its breathing
# animation and you could tell it was not really walking.
#
# gen5 sprites only carry the standing-still animation, so movement is BUILT
# here by deforming that frame: it is what any animator does with squash &
# stretch. No rotating, which looks dirty in pixel art: it scales, shifts and
# slants the rows (shear), which respect the pixel grid.
#
#   (dx, dy, fx, fy, shear[, patas])  on the base frame, anchored at the feet.
#
# The sixth field is optional and only the resting postures ask for it: how much
# the LEGS are compressed relative to the body (1.00 = equally, which is how
# everything was). Without it, sitting was a uniform scale and there was no
# posture at all: see aplastar_por_franjas(), which explains what showed in
# Umbreon and Machop.
ZONA_PATAS = 0.62     # the legs start from here down (fraction of the height)
POSE = {
    1:  (0,  0, 1.00, 1.00,  0.00),   # Stand: the reference one
    2:  (0, -3, 0.98, 1.02,  0.05),   # Walk, step A: rises and stretches
    3:  (0, -1, 1.03, 0.97, -0.04),   # Walk, step B: drops and squashes
    4:  (0,  0, 0.94, 1.08,  0.00),   # Falling: stretched through the air
    5:  (2,  0, 1.00, 1.00,  0.10),   # Resisting: struggles to one side
    6:  (-2, 0, 1.00, 1.00, -0.10),   # Resisting: and to the other
    7:  (0, -2, 0.96, 1.05,  0.06),   # Pinched: hanging from the mouse
    8:  (0, -2, 0.96, 1.05, -0.06),   # Pinched: swinging
    9:  (0, -3, 0.95, 1.06,  0.09),   # Pinched
    10: (0, -3, 0.95, 1.06, -0.09),   # Pinched
    11: (0,  0, 1.06, 0.86,  0.00, 0.30),   # Sit: bottom on the floor
    # The three WALL ones, which are no longer "just in case": the critter
    # really grabs the edge (see PAREDES). They are anchored at the side, not at
    # the feet (reanclar_por_borde), so the negative dx pulls it up to the wall
    # and the NEGATIVE shear leans its body towards it -- on the right wall the
    # engine mirrors the drawing and the lean flips to the other side by itself.
    # 13 is the still grip (GrabWall); 12 and 14 are the climbing cycle, and
    # they differ in how much it stretches, which is what reads as effort.
    12: (-6,  0, 0.94, 1.06, -0.10),  # ClimbWall: a stroke
    13: (-6, -2, 0.92, 1.08, -0.06),  # GrabWall: hanging, still
    14: (-6,  0, 0.94, 1.06, -0.13),  # ClimbWall: the other stroke
    15: (2,  0, 1.06, 0.86,  0.05, 0.30),   # SitAndSpinHead: sitting, looking
    16: (0,  0, 1.06, 0.86,  0.00, 0.30),
    17: (-2, 0, 1.06, 0.86, -0.05, 0.30),
    # THE IMPACT. These three are the ones you see when you throw the critter,
    # and they were overdone: a 112x84 frozen for eight ticks does not read as
    # an impact, it reads as a broken sprite (diego: "se aplasta y esta raro",
    # it squashes and looks odd, 13 Sep). The squash is still there -- without
    # it, the landing has no weight -- but at half strength.
    18: (0,  0, 1.06, 0.93,  0.00),   # Bouncing: the hit against the ground
    19: (0, -3, 0.96, 1.05,  0.00),   # Bouncing: the bounce back up
    20: (0,  0, 1.08, 0.90,  0.03, 0.35),   # Creep: crawling (and Tripping)
    # Sprawl is the most lying-down posture there is and it was the one that
    # showed least: on Lucario it is 126 px standing against 93 sprawled, that
    # is, the same critter standing but shorter. With the legs at 0.18 the body
    # really settles, and the shear -- which was at 0.00, with nothing to tilt
    # the axis- leans the torso to one side, which is what tells "sprawled"
    # apart from "crouched".
    21: (0,  0, 1.12, 0.74,  0.12, 0.18),   # Sprawl: sprawled out
    22: (0, -6, 0.92, 1.12,  0.00),   # Jumping: the jump
    23: (0,  0, 0.96, 1.04,  0.00),   # ClimbCeiling (switched off)
    24: (0,  0, 0.96, 1.04,  0.00),
    25: (0,  0, 0.96, 1.04,  0.00),
    26: (0, -1, 1.04, 0.88,  0.00, 0.30),   # SitAndLookAtMouse: looks at you
    27: (2, -1, 1.04, 0.88,  0.06, 0.30),
    28: (0, -1, 1.04, 0.88,  0.00, 0.30),
    29: (-2,-1, 1.04, 0.88, -0.06, 0.30),
    30: (0,  0, 1.05, 0.87,  0.00, 0.26),   # SitWithLegsUp: tucks them in more
    # DANGLING legs do not bend as much as crossed ones: 0.55 is halfway
    # between sitting (0.30) and standing (1.00), which is what a critter
    # sitting on the edge with its feet hanging over does.
    31: (0,  0, 1.04, 0.88,  0.00, 0.55),   # SitAndDangleLegs
    32: (0, -1, 1.04, 0.89,  0.02, 0.55),   # ...swinging its legs
    33: (0, -1, 1.04, 0.89, -0.02, 0.55),
    34: (0, -2, 0.99, 1.01,  0.04),   # WalkWithIe (switched off)
    35: (0, -1, 1.02, 0.98, -0.03),
    36: (0,  0, 0.95, 1.06,  0.00),
    37: (0, -3, 0.94, 1.07,  0.08),   # ThrowIe
    38: (0, -2, 0.97, 1.04,  0.05),   # PullUpShimeji
    39: (0, -3, 0.96, 1.05,  0.07),
    40: (0, -4, 0.95, 1.06,  0.09),
    41: (0, -5, 0.94, 1.07,  0.07),
    42: (0,  0, 1.00, 1.00,  0.00),   # Divide (splitting: left alone)
    43: (0,  0, 1.00, 1.00,  0.00),
    44: (0,  0, 1.00, 1.00,  0.00),
    45: (0,  0, 1.00, 1.00,  0.00),
    46: (0,  0, 1.00, 1.00,  0.00),
}

# What makes the critter pay attention to you. In the template they come at
# zero, so the pokemon ignored you: it walked, sat down and little else. With
# this it follows you, sits down to watch you and turns its head when you come
# close.
INTERACCION = {
    # ONE single way in. Frequency is a weight PER TRANSITION, not per time, so
    # raising five behaviours at once did not give "more interaction": it gave a
    # critter that kept changing its mind at every turn. The rest are entered
    # through the <NextBehaviorList> chain, which is how the template is meant
    # to work and which until now got lost in the conversion.
    #
    # 600 is NOT a random number: it is its weight against what it competes
    # with. Standing on the ground, the eligible behaviours are the ones in the
    # "ground" block (walking, running, sitting down on the way: 710) plus the
    # posture ones (getting up, sitting down: 450). With the template's 100 it
    # was picked 8% of the time -- a critter that pays attention one time in
    # twelve and ignores you the rest. With 600 it comes out a third: it attends
    # to you often and still has a life of its own. If one day you want it
    # clingier, the useful ceiling is ~1200 (half of the time).
    "ChaseMouse": 600,
    # Splitting (a clone of the pokemon). Until now it NEVER actually happened:
    # its action was discarded because of the disorder in actions.xml, so it was
    # dead code. Fixing the order would make it really happen, and a second
    # leader appearing on its own on the desktop reads as a bug, not as a joke
    # -- besides, the team has ONE leader out for a walk. It is switched off on
    # purpose: to get it back, just remove this line.
    "SplitIntoTwo": 0,
}

# The weights INSIDE a chain, which is a different thing from the ones above:
# here nothing competes with the rest of the world, it decides how long a
# moment lasts.
CADENAS = {
    # THE WELL. After chasing you, the critter sits down to watch you
    # (SitAndFaceMouse) and that behaviour chains INTO ITSELF with weight 100
    # against 1 and 1: it exits 1% of the time, that is, about a hundred
    # repetitions on average. Each repetition is nine stretches of watching and
    # turning its head, so it stayed sitting without moving for MORE THAN TEN
    # MINUTES. Seen from outside that is not "it is watching you": it is a hung
    # critter, and it is half of what looked like broken interaction.
    #
    # With 30 out of 100 on the way out it keeps watching about three times, a
    # good half minute, and then gets up and goes about its business.
    "SitAndFaceMouse": {
        "SitAndFaceMouse": 60,        # keep watching
        "SitAndSpinHead": 10,         # turns its head (and watches again)
        "SitWhileDanglingLegs": 30,   # the ONLY one back to the root list
    },
}

# ── THE EDGES: WALLS YES, CEILING NO ─────────────────────────────────────────
# All of this was switched off, and it had its reason: Hyprland does not clip
# the subsurfaces that stick out of the layer, it DEFORMS them to cram them in
# (hyprwm/Hyprland#9117, closed as "not planned"; live thread #10515), so the
# critter got squashed right at the edge. Not any more: wl_shimeji clips on the
# client side with wp_viewport (package pkgrel 3) and Hyprland carries the
# stale-box fix (0.56.2-3.2), so the edge is reached in one piece.
#
# But without grips something else ugly remained, which is what diego reported
# again on 13 Sep ("lo lanzo hacia los lados y se aplasta", I throw it sideways
# and it gets squashed): on hitting a side the critter kept FALLING stuck to the
# edge with the Falling pose, anchored at the centre, that is, half its width
# off screen for the whole fall, and then it stayed there standing, cut in half
# by the vertical, until another behaviour came up. Measured on video: ~5 s
# half off.
#
# With the grip switched on, on touching the wall it sticks with GrabWall, which
# reanclar_por_borde() anchors at the SIDE (0, ground): the whole drawing falls
# INSIDE the screen. It also climbs a bit and jumps off the wall, which was what
# diego was asking for ("igual si haces que pueda trepar", maybe if you make it
# able to climb).
PAREDES = {
    # REACTIVE: what it can do when it is ALREADY on the wall. There they only
    # compete with one another, so they keep the template's weights: holding
    # on twice as much as letting go, and climbing as much as holding on.
    "HoldOntoWall": 100,
    "FallFromWall": 50,
    "ClimbHalfwayAlongWall": 100,
    "JumpFromLeftWall": 50,
    "JumpFromRightWall": 50,
    # GOING TO LOOK FOR the wall from the ground. The template sets these four
    # at 100 each and they compete against the 710 of the ground block (walking,
    # running, sitting): 400 out of 1110 is a critter that spends half its life
    # in the corners. At 25 it comes up one transition in eleven -- it sidles up
    # to the edge now and then, which is fun, but it still lives in the middle.
    "GrabWorkAreaBottomLeftWall": 25,
    "GrabWorkAreaBottomRightWall": 25,
    "WalkAndGrabBottomLeftWall": 25,
    "WalkAndGrabBottomRightWall": 25,
}

# The ceiling stays out, and not because of a technical fault: the layer's
# "ceiling" is y=0, that is, the notch strip. A pokemon hanging from the bar
# gets into the chrome, which is exactly what diego does not want there.
# ClimbAlongWall is on this list even though it starts on the wall because it
# ENDS up top: it climbs the whole side and carries on along the ceiling. With
# --trepar all four are switched on.
TECHO = (
    "ClimbAlongWall", "ClimbAlongCeiling",
    "HoldOntoCeiling", "FallFromCeiling",
)

# ── WHO FLIES ─────────────────────────────────────────────────────────────────
# The flying type comes from ~/.cache/pokepalette/tipos.json, which is already
# downloaded. But the type does not tell the whole story: Gengar is ghost and
# levitates, Bronzong is steel and does too. Those go by hand, because the
# Levitate ability is not in the types file and is not worth 1025 more requests
# just for this.
#
# It was checked by looking at the sprites themselves: the ones that levitate
# rise and fall on their own inside the gif (Gengar travels 12 px), so when they
# are set to fly the animation already goes along with it.
LEVITAN = {
    92, 93, 94,        # Gastly, Haunter, Gengar
