[Unit]
# The notch's Bluetooth pairing agent.
#
# It answers what BlueZ asks halfway through a pairing ("does this code
# match?", "type these six digits"). Without it headphones pair all the same,
# because they ask nothing, but a keyboard or a gamepad fails SILENTLY: QML
# cannot export a D-Bus object and Quickshell's Bluetooth API has no agent
# callback at all. The full reason why is in the script's header.
#
# It does not depend on quickshell.service on purpose: if the shell is not
# there, the agent keeps pairing (blind, with no face in the notch) instead of
# not pairing at all.
Description=Bluetooth pairing agent (notch)
Documentation=file:///home/diego/.config/quickshell/scripts/bt-agent.py
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.config/quickshell/scripts/bt-agent.py
Restart=on-failure
RestartSec=2s
Slice=session.slice

[Install]
WantedBy=graphical-session.target
