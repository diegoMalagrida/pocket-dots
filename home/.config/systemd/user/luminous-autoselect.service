[Unit]
Description=Auto-answers the screen picker of xdg-desktop-portal-luminous
Documentation=https://github.com/waycrate/xdg-desktop-portal-luminous
PartOf=graphical-session.target
After=graphical-session.target
# It has to be listening BEFORE luminous tries to connect.
Before=xdg-desktop-portal-luminous.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/diego/.local/bin/luminous-autoselect
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
